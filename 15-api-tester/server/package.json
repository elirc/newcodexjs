{
  "name": "api-tester-server",
  "version": "1.0.0",
  "description": "Express, TypeScript, Knex, and PostgreSQL backend for Project 15: REST API Testing Tool.",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "migrate": "tsx scripts/database.ts migrate",
    "rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "seed": "tsx scripts/database.ts seed",
    "test": "tsx --test ../test/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "@types/pg": "^8.11.10"
  }
}
